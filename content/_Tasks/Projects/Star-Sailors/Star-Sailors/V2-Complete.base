source: _Tasks/Star-Sailors/Stories
filter:
  segment: "V2 Complete"
views:
  - type: cards
    name: Stories
    sort:
      - property: priority
        direction: DESC
      - property: status
        direction: ASC
    image: note.banner
    imageAspectRatio: 0.6
  - type: table
    name: All Tasks
    source: tasks
    filters:
      and:
        - file.path ^= "_Tasks/Star-Sailors/"
        - contains(text, "V2 Complete")
