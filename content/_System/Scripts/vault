#!/bin/bash
# Vault Master Command - One command to rule them all
# This script automatically sets up the environment and runs vault operations

set -e

# Resolve symlinks to get the actual script location
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
VAULT_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
VENV_DIR="$VAULT_ROOT/.venv"

# Function to ensure virtual environment is set up
ensure_venv() {
    if [ ! -d "$VENV_DIR" ]; then
        echo "🔧 Virtual environment not found. Setting up..."
        if [ ! -f "$SCRIPT_DIR/setup-venv.sh" ]; then
            echo "❌ Error: setup-venv.sh not found at $SCRIPT_DIR/setup-venv.sh"
            exit 1
        fi
        bash "$SCRIPT_DIR/setup-venv.sh"
    fi
}

# Function to activate venv and run Python script
run_python() {
    ensure_venv
    source "$VENV_DIR/bin/activate"
    python3 "$@"
    deactivate
}

# Function to show usage
show_usage() {
    cat << EOF
🚀 Vault Command - One Command for Everything

Usage: vault <command> [options]

Commands:
    setup           Set up Python virtual environment
    setup-ocr       Set up Tesseract OCR (fast, printed text)
    setup-easyocr   Set up EasyOCR (better for handwriting)
    organize        Organize current sprint
    organize-daily  Organize daily dashboard (route tasks, archive notes)
    new-dashboard   Create today's dashboard from template
    transcribe      Transcribe handwritten notes from sprint images
    migrate         Migrate old content to new structure
    new-sprint      Create new sprint from template
    tasks           View current sprint tasks
    menu            Interactive menu (quick-start)
    
Examples:
    vault setup                                  # Set up environment
    vault setup-ocr                              # Set up OCR for transcription
    vault organize                               # Organize most recent active sprint
    vault organize SSG-294                       # Organize specific sprint
    vault transcribe                             # Transcribe notes in recent sprint
    vault transcribe SSG-290 --dry-run           # Preview transcription
    vault migrate                                # Dry run migration
    vault migrate --auto                         # Execute migration
    vault new-sprint 296                         # Create SSG-296
    vault tasks                                  # View current tasks
    vault menu                                   # Interactive menu

For more help: vault <command> --help
EOF
}

# Main command router
case "$1" in
    setup)
        bash "$SCRIPT_DIR/setup-venv.sh"
        ;;
    
    setup-ocr)
        bash "$SCRIPT_DIR/setup-ocr.sh"
        ;;
    
    setup-easyocr)
        bash "$SCRIPT_DIR/setup-easyocr.sh"
        ;;
        
    organize)
        ensure_venv
        source "$VENV_DIR/bin/activate"
        
        if [ -z "$2" ]; then
            # Find most recent active sprint
            SPRINT_FILE=$(ls -t "$VAULT_ROOT/content/_Sprints/Active/"SSG-*.md 2>/dev/null | head -1)
            if [ -z "$SPRINT_FILE" ]; then
                echo "❌ No active sprint files found"
                exit 1
            fi
            echo "📝 Organizing: $(basename "$SPRINT_FILE")"
        else
            # Use specified sprint
            if [[ "$2" =~ ^[0-9]+$ ]]; then
                SPRINT_FILE="$VAULT_ROOT/content/_Sprints/Active/SSG-$2.md"
            elif [[ "$2" =~ ^SSG-[0-9]+$ ]]; then
                SPRINT_FILE="$VAULT_ROOT/content/_Sprints/Active/$2.md"
            else
                SPRINT_FILE="$2"
            fi
            
            if [ ! -f "$SPRINT_FILE" ]; then
                echo "❌ Sprint file not found: $SPRINT_FILE"
                exit 1
            fi
        fi
        
        python3 "$SCRIPT_DIR/organize_sprint.py" "$SPRINT_FILE"
        deactivate
        ;;
    
    transcribe)
        ensure_venv
        source "$VENV_DIR/bin/activate"
        
        # Check if at least one OCR engine is available
        HAS_OCR=false
        python3 -c "import pytesseract" 2>/dev/null && HAS_OCR=true
        python3 -c "import easyocr" 2>/dev/null && HAS_OCR=true
        
        if [ "$HAS_OCR" = false ]; then
            echo "❌ No OCR engine installed"
            echo "   For handwriting: vault setup-easyocr (recommended)"
            echo "   For printed text: vault setup-ocr (faster)"
            deactivate
            exit 1
        fi
        
        if [ -z "$2" ] || [[ "$2" == --* ]]; then
            # Find most recent active sprint
            SPRINT_FILE=$(ls -t "$VAULT_ROOT/content/_Sprints/Active/"SSG-*.md 2>/dev/null | head -1)
            if [ -z "$SPRINT_FILE" ]; then
                echo "❌ No active sprint files found"
                deactivate
                exit 1
            fi
            echo "📝 Transcribing: $(basename "$SPRINT_FILE")"
            python3 "$SCRIPT_DIR/transcribe_notes.py" "$SPRINT_FILE" "$@"
        else
            # Use specified sprint
            if [[ "$2" =~ ^[0-9]+$ ]]; then
                SPRINT_FILE="$VAULT_ROOT/content/_Sprints/Active/SSG-$2.md"
            elif [[ "$2" =~ ^SSG-[0-9]+$ ]]; then
                SPRINT_FILE="$VAULT_ROOT/content/_Sprints/Active/$2.md"
            else
                SPRINT_FILE="$2"
            fi
            
            if [ ! -f "$SPRINT_FILE" ]; then
                echo "❌ Sprint file not found: $SPRINT_FILE"
                deactivate
                exit 1
            fi
            
            python3 "$SCRIPT_DIR/transcribe_notes.py" "$SPRINT_FILE" "${@:3}"
        fi
        
        deactivate
        ;;
        
    migrate)
        ensure_venv
        source "$VENV_DIR/bin/activate"
        python3 "$SCRIPT_DIR/migrate_content.py" "${@:2}"
        deactivate
        ;;
        
    new-sprint)
        if [ -z "$2" ]; then
            echo "❌ Please specify sprint number"
            echo "   Usage: vault new-sprint <number>"
            exit 1
        fi
        
        SPRINT_NUM="$2"
        SPRINT_FILE="$VAULT_ROOT/content/_Sprints/Active/SSG-$SPRINT_NUM.md"
        TEMPLATE="$VAULT_ROOT/content/_Sprints/_Templates/sprint-template.md"
        
        if [ -f "$SPRINT_FILE" ]; then
            echo "⚠️  Sprint file already exists: $SPRINT_FILE"
            read -p "Overwrite? (y/n): " confirm
            if [ "$confirm" != "y" ]; then
                echo "Cancelled."
                exit 0
            fi
        fi
        
        cp "$TEMPLATE" "$SPRINT_FILE"
        
        # Replace XXX with actual sprint number
        if [[ "$OSTYPE" == "darwin"* ]]; then
            sed -i '' "s/SSG-XXX/SSG-$SPRINT_NUM/g" "$SPRINT_FILE"
            sed -i '' "s/YYYY-MM-DD/$(date +%Y-%m-%d)/g" "$SPRINT_FILE"
        else
            sed -i "s/SSG-XXX/SSG-$SPRINT_NUM/g" "$SPRINT_FILE"
            sed -i "s/YYYY-MM-DD/$(date +%Y-%m-%d)/g" "$SPRINT_FILE"
        fi
        
        echo "✅ Created new sprint: SSG-$SPRINT_NUM"
        echo "   Location: $SPRINT_FILE"
        echo ""
        echo "Next steps:"
        echo "1. Open the file in Obsidian"
        echo "2. Update sprint goals and epic"
        echo "3. Start adding notes and tasks!"
        ;;
    
    organize-daily)
        ensure_venv
        source "$VENV_DIR/bin/activate"
        
        if [ -z "$2" ] || [[ "$2" == --* ]]; then
            # Find today's dashboard or use template
            TODAY=$(date +%Y-%m-%d)
            DASHBOARD="$VAULT_ROOT/content/_Daily/$TODAY.md"
            
            if [ ! -f "$DASHBOARD" ]; then
                DASHBOARD="$VAULT_ROOT/content/_Daily/Dashboard-Template.md"
            fi
            
            if [ ! -f "$DASHBOARD" ]; then
                echo "❌ No dashboard found"
                echo "   Run: vault new-dashboard"
                deactivate
                exit 1
            fi
            
            python3 "$SCRIPT_DIR/organize_daily.py" "$DASHBOARD" "$@"
        else
            python3 "$SCRIPT_DIR/organize_daily.py" "$2" "${@:3}"
        fi
        
        deactivate
        ;;
    
    new-dashboard)
        TODAY=$(date +%Y-%m-%d)
        DASHBOARD="$VAULT_ROOT/content/_Daily/$TODAY.md"
        TEMPLATE="$VAULT_ROOT/content/_Daily/Dashboard-Template.md"
        
        if [ -f "$DASHBOARD" ]; then
            echo "⚠️  Today's dashboard already exists: $DASHBOARD"
            read -p "Overwrite? (y/n): " confirm
            if [ "$confirm" != "y" ]; then
                echo "Opening existing dashboard..."
                echo "$DASHBOARD"
                exit 0
            fi
        fi
        
        if [ ! -f "$TEMPLATE" ]; then
            echo "❌ Template not found: $TEMPLATE"
            exit 1
        fi
        
        # Create dashboard from template
        cp "$TEMPLATE" "$DASHBOARD"
        
        # Replace date placeholders
        if [[ "$OSTYPE" == "darwin"* ]]; then
            sed -i '' "s/{{date:YYYY-MM-DD}}/$TODAY/g" "$DASHBOARD"
        else
            sed -i "s/{{date:YYYY-MM-DD}}/$TODAY/g" "$DASHBOARD"
        fi
        
        echo "✅ Created today's dashboard: $TODAY"
        echo "   Location: $DASHBOARD"
        echo ""
        echo "Next steps:"
        echo "1. Open in Obsidian"
        echo "2. Dump notes and create tasks"
        echo "3. Run: vault organize-daily"
        ;;
        
    tasks)
        TASK_FILE="$VAULT_ROOT/content/_Tasks/Current-Sprint.md"
        if [ -f "$TASK_FILE" ]; then
            if command -v bat &> /dev/null; then
                bat "$TASK_FILE"
            elif command -v less &> /dev/null; then
                less "$TASK_FILE"
            else
                cat "$TASK_FILE"
            fi
        else
            echo "ℹ️  No Current-Sprint.md found yet"
            echo "   Run: vault organize"
        fi
        ;;
        
    menu)
        bash "$SCRIPT_DIR/quick-start.sh"
        ;;
        
    help|--help|-h)
        show_usage
        ;;
        
    "")
        show_usage
        ;;
        
    *)
        echo "❌ Unknown command: $1"
        echo ""
        show_usage
        exit 1
        ;;
esac
